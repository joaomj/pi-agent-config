{
  "theme": "system",
  "quietStartup": false,
  "enableInstallTelemetry": true,
  "enableSkillCommands": true,
  "defaultProvider": "meta",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "xhigh",
  "cacheWarming": "streaming",
  "modelThinkingLevels": {
    "meta/muse-spark-1.3-contributor": "xhigh",
    "openai/gpt-6.1-sol": "xhigh",
    "openai-codex/gpt-6-astra": "low"
  },
  "transport": "websocket-cached",
  "defaultTools": [
    "+codemode"
  ],
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 64000
  },
  "enabledModels": [
    "meta/muse-spark-1.3-contributor:xhigh",
    "openai/gpt-6.1-sol:xhigh",
    "openai-codex/gpt-6-astra:low"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff",
    "/Users/joao/projects/pi-packages/packages/pi-permission-system",
    "npm:@kiranpg/pi-sentry",
    {
      "source": "npm:donsetch",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "/Users/joao/projects/pi-subagents",
    "npm:pi-open-tui",
    "npm:pi-claude-directsdk"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "showTerminalProgress": false
  },
  "collapseChangelog": true,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "codemode": {
    "mode": "on",
    "inlineBudget": 3000
  },
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ]
}