{
  "theme": "dark",
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "defaultProvider": "meta",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "xhigh",
  "cacheWarming": "streaming",
  "modelThinkingLevels": {
    "meta/muse-spark-1.3-contributor": "xhigh",
    "openai-codex/gpt-6-luna": "max",
    "openai-codex/gpt-6-astra": "low"
  },
  "transport": "websocket-cached",
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 64000
  },
  "enabledModels": [
    "meta/muse-spark-1.3-contributor:xhigh",
    "openai-codex/gpt-6-luna:max",
    "openai-codex/gpt-6-astra:low"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff",
    "/Users/joao/projects/pi-packages/packages/pi-permission-system",
    "npm:@kiranpg/pi-sentry",
    {
      "source": "npm:donsetch",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:pi-usage-meters",
    "/Users/joao/projects/pi-subagents",
    "npm:pi-open-tui",
    "npm:pi-claude-directsdk"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "transcript",
  "fullscreenCopyOnSelect": true,
  "defaultTools": [
    "read",
    "bash",
    "codemode"
  ],
  "codemode": {
    "mode": "only",
    "inlineBudget": 3000
  },
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ]
}
