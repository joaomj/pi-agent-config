{
  "theme": "dark",
  "quietStartup": false,
  "enableInstallTelemetry": true,
  "enableSkillCommands": true,
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "low",
  "cacheWarming": "streaming",
  "modelThinkingLevels": {
    "openai/gpt-6.1-sol": "low"
  },
  "transport": "websocket-cached",
  "defaultTools": [
    "+codemode"
  ],
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 64000
  },
  "enabledModels": [
    "openai/gpt-6.1-sol"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:@gotgenes/pi-permission-system@39.0.3",
    "npm:@kiranpg/pi-sentry@0.1.2",
    "npm:visual-explainer@0.12.0",
    "npm:@joaomj/pi-attention-span@0.8.0",
    "npm:pi-background-run@0.8.0",
    "npm:@spences10/pi-telemetry@0.0.33",
    "npm:@specode/pi-subscription-usage@1.3.1"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "showTerminalProgress": false
  },
  "collapseChangelog": true,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "codemode": {
    "mode": "on",
    "inlineBudget": 3000
  },
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ],
  "doubleEscapeAction": "none",
  "defaultProjectTrust": "ask",
  "lastChangelogVersion": "0.99.2"
}
