{
  "lastChangelogVersion": "0.87.1",
  "theme": "dark",
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "defaultProvider": "meta",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "xhigh",
  "cacheWarming": "streaming",
  "modelThinkingLevels": {
    "meta/muse-spark-1.3-contributor": "xhigh",
    "openai-codex/gpt-6-luna": "max",
    "openai-codex/gpt-6-astra": "low"
  },
  "transport": "websocket-cached",
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 64000
  },
  "enabledModels": [
    "meta/muse-spark-1.3-contributor:xhigh",
    "openai-codex/gpt-6-luna:max",
    "openai-codex/gpt-6-astra:low"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:@gotgenes/pi-permission-system@35.0.0",
    "npm:@kiranpg/pi-sentry@0.1.2",
    "npm:donsetch@4.3.6",
    "npm:pi-usage-meters@0.5.0",
    "npm:@tintinweb/pi-subagents@0.19.0",
    "npm:pi-open-tui@0.3.9"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "transcript",
  "fullscreenCopyOnSelect": true
}
