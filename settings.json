{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "quietStartup": false,
  "enableSkillCommands": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-luna": "xhigh",
    "openai-codex/gpt-5.6-sol": "medium",
    "openai-codex/gpt-6-astra": "low",
    "openrouter/meta/muse-spark-1.3-contributor": "xhigh",
    "openrouter/deepseek/deepseek-v4.1-flash": "xhigh"
  },
  "transport": "websocket-cached",
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 50000
  },
  "enabledModels": [
    "openai-codex/gpt-5.6-luna:xhigh",
    "openai-codex/gpt-5.6-sol:medium",
    "openai-codex/gpt-6-astra:low",
    "openrouter/meta/muse-spark-1.3-contributor:xhigh",
    "openrouter/deepseek/deepseek-v4.1-flash:xhigh"
  ],
  "packages": [
    "npm:@gotgenes/pi-permission-system",
    "npm:@kiranpg/pi-sentry@0.1.2",
    "npm:pi-web-access",
    {
      "source": "npm:pine-of-glass",
      "extensions": ["extensions/pi-meantime/**"]
    },
    "npm:pi-rewind-unwind"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "transcript",
  "fullscreenCopyOnSelect": true
}
