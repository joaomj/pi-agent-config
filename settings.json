{
  "theme": "dark",
  "quietStartup": false,
  "enableInstallTelemetry": true,
  "enableSkillCommands": true,
  "defaultProvider": "meta",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "xhigh",
  "cacheWarming": "streaming",
  "modelThinkingLevels": {
    "meta/muse-spark-1.3-contributor": "xhigh",
    "openai/gpt-6-astra": "low",
    "openai/gpt-6-luna": "xhigh",
    "openai/gpt-6.1-sol": "high",
    "openrouter/deepseek/deepseek-v4.1-flash": "low"
  },
  "transport": "websocket-cached",
  "defaultTools": [
    "+codemode"
  ],
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 64000
  },
  "enabledModels": [
    "openai/gpt-6-luna",
    "openai/gpt-6-astra",
    "openai/gpt-6.1-sol",
    "meta/muse-spark-1.3-contributor"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff",
    "/Users/joao/projects/pi-packages/packages/pi-permission-system",
    "npm:@kiranpg/pi-sentry",
    "npm:pi-open-tui",
    "npm:proper-compact",
    "npm:visual-explainer",
    "npm:@joaomj/pi-attention-span@0.8.0",
    "npm:pi-background-run"
  ],
  "tuiMode": "regular",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "showTerminalProgress": false
  },
  "collapseChangelog": true,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "codemode": {
    "mode": "on",
    "inlineBudget": 3000
  },
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ],
  "lastChangelogVersion": "0.99.2",
  "doubleEscapeAction": "none",
  "defaultProjectTrust": "always"
}