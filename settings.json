{
  "lastChangelogVersion": "0.87.1",
  "theme": "dark",
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "defaultProvider": "meta",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "high",
  "cacheWarming": "streaming",
  "modelThinkingLevels": {
    "openrouter/meta/muse-spark-1.3-contributor": "xhigh",
    "openrouter/z-ai/glm-5.3-flash": "low"
  },
  "transport": "websocket-cached",
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 24000
  },
  "enabledModels": [
    "openrouter/meta/muse-spark-1.3-contributor:xhigh",
    "openrouter/z-ai/glm-5.3-flash:low",
    "meta/muse-spark-1.3-contributor"
  ],
  "packages": [
    "npm:@gotgenes/pi-permission-system",
    "npm:@kiranpg/pi-sentry@0.1.2",
    "npm:pi-web-access",
    {
      "source": "npm:pine-of-glass",
      "extensions": [
        "extensions/pi-meantime/**",
        "extensions/pi-cachemire/**"
      ]
    },
    "npm:pi-rewind-unwind"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "transcript",
  "fullscreenCopyOnSelect": true
}