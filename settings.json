{
  "theme": "dark",
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "xhigh",
  "cacheWarming": "streaming",
  "modelThinkingLevels": {
    "openai/gpt-6-luna": "xhigh",
    "openai/gpt-6.1-sol": "low"
  },
  "transport": "websocket-cached",
  "defaultTools": [
    "read",
    "bash",
    "codemode"
  ],
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 64000
  },
  "enabledModels": [
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol"
  ],
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@gotgenes/pi-permission-system",
    "npm:@kiranpg/pi-sentry",
    "npm:visual-explainer",
    "npm:@joaomj/pi-attention-span",
    "npm:pi-background-run",
    "npm:@spences10/pi-telemetry",
    "npm:@specode/pi-subscription-usage",
    "git:github.com/joaomj/pi-claude-directsdk"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "showTerminalProgress": false
  },
  "collapseChangelog": true,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "codemode": {
    "mode": "on",
    "inlineBudget": 0
  },
  "npmCommand": [
    "npm",
    "--ignore-scripts"
  ],
  "doubleEscapeAction": "none",
  "defaultProjectTrust": "ask",
  "enableAnalytics": false
}
