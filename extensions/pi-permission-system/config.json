{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "promptMaxRows": 24,
  "promptFieldMaxWidth": 400,
  "reviewLogFieldMaxWidth": 1000,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [],
  "permission": {
    "*": "allow",

    "path_read": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "*.env*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",

      "*credentials*": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.netrc": "deny",
      "*.authinfo": "deny",
      "*auth.json": "deny",
      "*auth.json*": "deny",
      "**/.docker/config.json": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "*hosts.yml*": "deny",
      "*shadow*": "deny",
      "*bash_history*": "deny",
      "*zsh_history*": "deny",

      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/config": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.gnupg/*": "deny",
      "~/.ssh/config": "ask",

      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.ppk": "deny",
      "*.p8": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*id_dsa*": "deny",
      "*_rsa": "deny",
      "*_ecdsa": "deny",
      "*_ecdsa_sk": "deny",
      "*_ed25519": "deny",
      "*_ed25519_sk": "deny",
      "*_dsa": "deny",
      "*.pub": "allow"
    },

    "path_write": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "*.env*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",

      "*credentials*": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.netrc": "deny",
      "*.authinfo": "deny",
      "*auth.json": "deny",
      "*auth.json*": "deny",
      "**/.docker/config.json": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "*hosts.yml*": "deny",
      "*shadow*": "deny",
      "*bash_history*": "deny",
      "*zsh_history*": "deny",

      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/config": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*/.gnupg/*": "deny",
      "~/.ssh/config": "ask",

      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.ppk": "deny",
      "*.p8": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*id_dsa*": "deny",
      "*_rsa": "deny",
      "*_ecdsa": "deny",
      "*_ecdsa_sk": "deny",
      "*_ed25519": "deny",
      "*_ed25519_sk": "deny",
      "*_dsa": "deny",
      "*.pub": "allow",

      "/etc/*": "deny",
      "/usr/*": "deny",
      "/bin/*": "deny",
      "/sbin/*": "deny",
      "/boot/*": "deny",
      "/sys/*": "deny",
      "/proc/*": "deny"
    },

    "read": "allow",
    "ls": "allow",
    "grep": "allow",
    "find": "allow",
    "external_directory": "ask",

    "bash": {
      "*": "allow",

      "sudo *": { "action": "deny", "reason": "Privilege escalation is an owner action." },
      "doas *": { "action": "deny", "reason": "Privilege escalation is an owner action." },
      "su": "deny",
      "su *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "chgrp *": "deny",
      "chattr *": "deny",
      "setfacl *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "dd *": "deny",
      "shred *": "deny",
      "mkfs*": "deny",
      "systemctl *": "ask",
      "service *": "ask",
      "crontab *": "ask",

      "rm -rf /*": { "action": "deny", "reason": "Recursive deletion from the filesystem root is never correct." },
      "rm -fr /*": { "action": "deny", "reason": "Recursive deletion from the filesystem root is never correct." },
      "rm -rf ~*": { "action": "deny", "reason": "Recursive deletion of the home directory is never correct." },
      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "truncate *": "ask",
      "rsync *": "ask",

      "*/.ssh/*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_ecdsa*": "deny",
      "*id_dsa*": "deny",
      "*.pem": "deny",
      "*.env*": "deny",
      "*shadow*": "deny",
      "*credentials*": "deny",
      "*auth.json*": "deny",
      "*hosts.yml*": "deny",
      "*.npmrc": "deny",
      "*169.254.169.254*": { "action": "deny", "reason": "The cloud instance metadata endpoint holds credentials." },
      "*169.254.*": { "action": "deny", "reason": "Link-local addresses can expose credential endpoints." },
      "cat *.pub": "allow",
      "ssh-keygen -lf *.pub": "allow",
      "ssh-keygen -t *": { "action": "deny", "reason": "Key creation is an owner action." },

      "bash -c *": "ask",
      "sh -c *": "ask",
      "dash -c *": "ask",
      "zsh -c *": "ask",
      "ksh -c *": "ask",
      "eval *": "ask",
      "xargs *": "ask",
      "busybox *": "ask",
      "sed -i*": "ask",
      "sed --in-place*": "ask",
      "tee *": "ask",
      "perl *": "ask",
      "ruby *": "ask",
      "node *": "ask",

      "git clean *": "deny",
      "git reset --hard*": { "action": "deny", "reason": "This discards uncommitted work." },
      "git reset --merge*": "deny",
      "git reset --keep*": "deny",
      "git checkout -- *": { "action": "deny", "reason": "This discards uncommitted work." },
      "git restore *": { "action": "deny", "reason": "This discards uncommitted work." },
      "git branch -D*": "deny",
      "git branch --delete --force*": "deny",
      "git stash clear": "deny",
      "git stash drop*": "deny",
      "git filter-branch*": "deny",
      "git push --force*": { "action": "deny", "reason": "Use --force-with-lease and ask first." },
      "git push -f*": { "action": "deny", "reason": "Use --force-with-lease and ask first." },

      "git commit*": "ask",
      "git push*": "ask",
      "git tag *": "ask",
      "git tag -d*": "ask",
      "git merge *": "ask",
      "git rebase*": "ask",
      "git cherry-pick*": "ask",
      "git revert*": "ask",
      "git am *": "ask",
      "git apply *": "ask",
      "git clone *": "ask",
      "git worktree *": "ask",
      "git remote add *": "ask",
      "git remote set-url *": "ask",
      "git config *": "ask",
      "git config --get*": "allow",
      "git config --list*": "allow",
      "git gc*": "ask",
      "git reflog delete*": "ask",

      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh pr edit*": "ask",
      "gh pr review*": "ask",
      "gh pr comment*": "ask",
      "gh pr ready*": "ask",
      "gh pr reopen*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue comment*": "ask",
      "gh release create*": "ask",
      "gh release edit*": "ask",
      "gh release delete*": "ask",
      "gh release upload*": "ask",
      "gh workflow run*": "ask",
      "gh workflow enable*": "ask",
      "gh workflow disable*": "ask",
      "gh run cancel*": "ask",
      "gh run rerun*": "ask",
      "gh repo create*": "ask",
      "gh repo edit*": "ask",
      "gh repo fork*": "ask",
      "gh repo delete*": { "action": "deny", "reason": "Repository deletion is an owner action." },
      "gh secret *": "ask",
      "gh variable *": "ask",
      "gh api *": "ask",
      "gh auth login*": "ask",
      "gh auth logout*": "ask",
      "gh gist create*": "ask",
      "gh label create*": "ask",
      "gh label delete*": "ask",
      "gh ssh-key add*": { "action": "deny", "reason": "Key registration is an owner action." },
      "gh ssh-key delete*": { "action": "deny", "reason": "Key removal is an owner action." },

      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "sftp *": "ask",
      "nc *": "ask",
      "ncat *": "ask",
      "telnet *": "ask",
      "socat *": "ask",

      "pip install*": "ask",
      "pip uninstall*": "ask",
      "pip3 install*": "ask",
      "pip3 uninstall*": "ask",
      "uv sync*": "ask",
      "uv lock*": "ask",
      "uv add *": "ask",
      "uv remove *": "ask",
      "uv pip install*": "ask",
      "uv pip uninstall*": "ask",
      "uv tool install*": "ask",
      "uv tool uninstall*": "ask",
      "uv self update*": "ask",
      "uv cache clean*": "ask",
      "uv venv*": "ask",
      "poetry add *": "ask",
      "poetry install*": "ask",
      "npm install*": "ask",
      "npm ci*": "ask",
      "npm uninstall*": "ask",
      "npm update*": "ask",
      "npm publish*": "ask",
      "npx *": "ask",
      "pnpm add*": "ask",
      "pnpm install*": "ask",
      "pnpm publish*": "ask",
      "yarn add*": "ask",
      "yarn install*": "ask",
      "yarn publish*": "ask",
      "cargo install*": "ask",
      "cargo publish*": "ask",
      "go install*": "ask",
      "gem install*": "ask",
      "brew install*": "ask",
      "brew uninstall*": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "yum *": "ask",
      "pacman *": "ask",
      "twine *": "ask",

      "ruff check*": "ask",
      "ruff check *--no-fix*": "allow",
      "ruff format*": "ask",
      "ruff format --check*": "allow",
      "uv run ruff check*": "ask",
      "uv run ruff check *--no-fix*": "allow",
      "uv run ruff format*": "ask",
      "uv run ruff format --check*": "allow",
      "make lint*": "ask",
      "make format*": "ask",
      "make deploy*": "ask",
      "make release*": "ask",

      "docker push*": "ask",
      "docker run *": "ask",
      "docker exec *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker system prune*": "ask",
      "docker compose up*": "ask",
      "docker compose down*": "ask",
      "docker run *--privileged*": { "action": "deny", "reason": "A privileged container is never permitted." },
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl exec*": "ask",
      "kubectl port-forward*": "ask",
      "helm install*": "ask",
      "helm upgrade*": "ask",
      "helm uninstall*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "terraform import*": "ask",
      "terraform state *": "ask",
      "terraform init*": "ask",

      "aws *create*": "ask",
      "aws *update*": "ask",
      "aws *modify*": "ask",
      "aws *put*": "ask",
      "aws *delete*": "ask",
      "aws *terminate*": "ask",
      "aws secretsmanager get-secret-value*": "ask",
      "gcloud * create*": "ask",
      "gcloud * delete*": "ask",
      "az * create*": "ask",
      "az * delete*": "ask"
    },

    "mcp": {
      "*": "allow"
    },

    "skill": "allow"
  }
}
