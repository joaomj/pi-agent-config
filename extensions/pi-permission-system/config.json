{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "promptMaxRows": 24,
  "promptFieldMaxWidth": 400,
  "reviewLogFieldMaxWidth": 1000,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [],
  "permission": {
    "*": "allow",

    "path": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",

      "/etc/shadow*": "deny",
      "/etc/ssh/*_key": "deny",

      "~/.ssh/*": "ask",
      "*/.ssh/*": "ask",

      "~/.aws/*": "ask",
      "*/.aws/*": "ask",
      "~/.aws/credentials": "deny",
      "*/.aws/credentials": "deny",
      "~/.gnupg/*": "deny",
      "*/.gnupg/*": "deny",
      "~/.kube/config": "ask",
      "**/.docker/config.json": "deny",
      "**/.config/gh/hosts.yml": "deny",

      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.ppk": "deny",
      "*.p8": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*id_ecdsa": "deny",
      "*id_dsa": "deny",
      "*_sk": "deny",
      "*.pub": "allow",

      "*auth.json": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.netrc": "deny",
      "*.authinfo": "deny"
    },

    "read": "allow",
    "ls": "allow",
    "grep": "allow",
    "find": "allow",
    "external_directory": "allow",

    "bash": {
      "*": "allow",

      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "dd *": "ask",
      "shred *": "ask",
      "mkfs*": "ask",

      "sudo *": "ask",
      "doas *": "ask",
      "su *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chgrp *": "ask",

      "pip install*": "ask",
      "pip uninstall*": "ask",
      "pip3 install*": "ask",
      "pip3 uninstall*": "ask",
      "uv sync*": "ask",
      "uv add *": "ask",
      "uv remove *": "ask",
      "uv pip install*": "ask",
      "uv pip uninstall*": "ask",
      "uv tool install*": "ask",
      "uv tool uninstall*": "ask",
      "poetry add *": "ask",
      "poetry install*": "ask",
      "npm install*": "ask",
      "npm ci*": "ask",
      "npm uninstall*": "ask",
      "npm update*": "ask",
      "npm publish*": "ask",
      "npx *": "ask",
      "pnpm add*": "ask",
      "pnpm install*": "ask",
      "pnpm publish*": "ask",
      "yarn add*": "ask",
      "yarn install*": "ask",
      "yarn publish*": "ask",
      "cargo install*": "ask",
      "cargo publish*": "ask",
      "go install*": "ask",
      "gem install*": "ask",
      "brew install*": "ask",
      "brew uninstall*": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "yum *": "ask",
      "pacman *": "ask",
      "twine *": "ask",
      "curl *": "ask",
      "wget *": "ask",

      "git add -A*": "ask",
      "git add --all*": "ask",
      "git add .": "ask",
      "git add ./*": "ask",
      "git checkout .": "ask",
      "git checkout ./*": "ask",
      "git checkout -- *": "ask",
      "git checkout HEAD*": "ask",
      "git clean *": "ask",
      "git reset*": "ask",
      "git restore *": "ask",
      "git branch -D*": "ask",
      "git branch --delete --force*": "ask",
      "git stash": "ask",
      "git stash push*": "ask",
      "git stash drop*": "ask",
      "git stash clear": "ask",
      "git filter-branch*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git tag *": "ask",
      "git tag -d*": "ask",
      "git merge *": "ask",
      "git rebase*": "ask",
      "git cherry-pick*": "ask",
      "git revert*": "ask",

      "docker run *--privileged*": "ask",
      "make deploy*": "ask",
      "make release*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "helm install*": "ask",
      "helm upgrade*": "ask",
      "helm uninstall*": "ask",

      "aws *create*": "ask",
      "aws *update*": "ask",
      "aws *modify*": "ask",
      "aws *put*": "ask",
      "aws *delete*": "ask",
      "aws *terminate*": "ask",
      "aws secretsmanager get-secret-value*": "ask",
      "gcloud * create*": "ask",
      "gcloud * delete*": "ask",
      "az * create*": "ask",
      "az * delete*": "ask",

      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh pr edit*": "ask",
      "gh pr review*": "ask",
      "gh pr comment*": "ask",
      "gh pr ready*": "ask",
      "gh pr reopen*": "ask",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue comment*": "ask",
      "gh issue reopen*": "ask",
      "gh issue delete*": "ask",
      "gh release create*": "ask",
      "gh release edit*": "ask",
      "gh release delete*": "ask",
      "gh release upload*": "ask",
      "gh repo create*": "ask",
      "gh repo edit*": "ask",
      "gh repo fork*": "ask",
      "gh repo delete*": "ask",
      "gh secret *": "ask",
      "gh variable *": "ask",
      "gh api *": "ask",
      "gh auth *": "ask",
      "gh workflow run*": "ask",
      "gh workflow enable*": "ask",
      "gh workflow disable*": "ask",
      "gh run cancel*": "ask",
      "gh run rerun*": "ask",
      "gh gist create*": "ask",
      "gh label create*": "ask",
      "gh label delete*": "ask",
      "gh ssh-key add*": "ask",
      "gh ssh-key delete*": "ask",

      "ssh-keygen -t *": "ask",

      "*169.254.*": { "action": "deny", "reason": "Link-local addresses can expose credential endpoints." }
    },

    "mcp": {
      "*": "allow"
    },

    "skill": "allow"
  }
}
