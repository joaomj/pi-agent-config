{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "promptMaxRows": 24,
  "promptFieldMaxWidth": 400,
  "reviewLogFieldMaxWidth": 1000,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [],
  "permission": {
    "*": "ask",
    "path_read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*secret*": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.netrc": "deny",
      "*.authinfo": "deny",
      "**/.docker/config.json": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "*auth.json": "deny",
      "*trust.json": "deny"
    },
    "path_write": {
      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*secret*": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.git-credentials": "deny",
      "*.netrc": "deny",
      "*.authinfo": "deny",
      "**/.docker/config.json": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "*auth.json": "deny",
      "*trust.json": "deny"
    },
    "read": "allow",
    "ls": "allow",
    "grep": "allow",
    "find": "allow",
    "bash": {
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "date": "allow",
      "uname *": "allow",
      "jq *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show *": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git grep*": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git branch --list*": "allow",
      "git tag --list*": "allow",
      "git remote -v": "allow",
      "git remote get-url*": "allow",
      "python": "deny",
      "python *": "deny",
      "python3": "deny",
      "python3 *": "deny",
      "pip": "deny",
      "pip *": "deny",
      "pip3": "deny",
      "pip3 *": "deny",
      "pytest": "deny",
      "pytest *": "deny",
      "ruff": "deny",
      "ruff *": "deny",
      "mypy": "deny",
      "mypy *": "deny"
    },
    "mcp": {
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow"
    },
    "skill": "allow"
  }
}
