{
  "mcpServers": {
    "donsetch": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/npm/node_modules/.bin/donsetch\" mcp --supervised"
      ],
      "timeout": 620,
      "exposure": "codemode"
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
      "timeout": 300,
      "exposure": "codemode",
      "description": "Firecrawl web search, scrape, crawl, and extract through account sign-in."
    }
  }
}
