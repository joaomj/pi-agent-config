# secrets - never commit
auth.json
mcp-auth.json
trust.json
.env
settings.local.json
mcp.local.json

# runtime / cache - never commit
sessions/
state/
models-store.json
web-search-cache/
fff/
web-search.json
*.log
mcp.log*
*.bak*
permission-system-config.json
pi-permissions.jsonc
config.public.json
usage-meters-state.json
# permission-system review/debug logs contain unredacted commands - never commit
extensions/*/logs/

# local credentials and private material - never commit
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.netrc
*.npmrc
**/auth.json
**/trust.json
**/*credentials*
**/*secret*

# local tool binaries
/bin/

# Pi manages installation records locally; settings.json declares packages.
npm/*
!npm/.gitignore
git/

# OS
.DS_Store

# Account-local telemetry preference and session recordings
telemetry.json
telemetry.db
telemetry.db-*

# Obsolete package pins are not shared configuration
versions.lock

# Account-local Pi runtime
/install/

# Personal Pi configuration and extensions stay on this machine.
/settings*.json
/settings*.json.example
/mcp*.json
/mcp*.json.example
/models.json
/profiles/
/extensions/
/pi-fff.json
/telemetry.json.example
