# secrets - never commit
auth.json
trust.json

# runtime / cache - never commit
sessions/
state/
models-store.json
web-search-cache/
web-search.json
*.log
*.bak*
permission-system-config.json
pi-permissions.jsonc
config.public.json
usage-meters-state.json
# permission-system review/debug logs contain unredacted commands - never commit
extensions/*/logs/

# local credentials and private material - never commit
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.netrc
*.npmrc
**/auth.json
**/trust.json
**/*credentials*
**/*secret*

# local tool binaries
/bin/

# Installed packages are reproduced from the tracked lockfile.
npm/*
!npm/package.json
!npm/package-lock.json
!npm/.gitignore
git/

# OS
.DS_Store
